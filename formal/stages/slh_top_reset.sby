[options]
mode bmc
depth 80
multiclock on

[engines]
smtbmc boolector

[script]
read -formal -sv fv_slh_top_reset.sv slh_verify_top.sv hmsg.sv fors_verify.sv wots_verify.sv xmss_verify.sv ht_verify.sv thash.sv sig_ram.sv scratch_ram.sv adrs.sv shake256.sv keccak_f1600.sv keccak_round.sv
chparam -set RPC 4 -set SCRATCH_STYLE 0 slh_verify_top
prep -top fv_slh_top_reset

